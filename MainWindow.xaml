<Window x:Class="ProxySwitcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ProxySwitcher"
        mc:Ignorable="d"
        Title="Proxy Switcher"
        Height="600"
        Width="700"
        Background="#F5F5F5"
        Foreground="#333333"
        FontSize="12"
        Closing="Window_Closing">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Margin" Value="5"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="MinWidth" Value="70"/>
        </Style>
        <Style TargetType="Label">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,5,0,5"/>
        </Style>
    </Window.Resources>

    <Grid>
        <StackPanel Margin="15">
            <!-- Status Section -->
            <Border BorderBrush="#CCCCCC" BorderThickness="1" Padding="15" CornerRadius="5" Background="White" Margin="0,0,0,15">
                <StackPanel>
                    <TextBlock Text="Current Status" FontSize="14" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock x:Name="StatusTextBlock" Text="Proxy: Disabled" FontSize="12" Foreground="#555555" Margin="0,0,0,10"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button x:Name="DisableButton" 
                                Content="Disable Proxy" 
                                Click="DisableButton_Click" 
                                Background="#FF6B6B" 
                                Foreground="White"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Profiles Section -->
            <Label Content="Proxy Profiles" FontSize="14" FontWeight="Bold"/>

            <!-- Profile List -->
            <ListBox x:Name="ProfilesListBox" 
                     Height="250" 
                     Margin="0,5,0,10"
                     BorderBrush="#CCCCCC"
                     BorderThickness="1"
                     Background="White"
                     MouseDoubleClick="ProfilesListBox_DoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="5">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="#2196F3"/>
                                <TextBlock Text=" - " Margin="5,0"/>
                                <TextBlock Text="{Binding Host}" Foreground="#555555"/>
                                <TextBlock Text=":" Foreground="#555555"/>
                                <TextBlock Text="{Binding Port}" Foreground="#555555"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="System: " FontSize="11" Foreground="#999999"/>
                                <TextBlock Text="{Binding EnableSystemProxy}" FontSize="11" Foreground="#999999"/>
                                <TextBlock Text=" | Env Vars: " FontSize="11" Foreground="#999999"/>
                                <TextBlock Text="{Binding EnableEnvironmentVariables}" FontSize="11" Foreground="#999999"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Action Buttons -->
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,15">
                <Button x:Name="ActivateButton" 
                        Content="Activate" 
                        Click="ActivateButton_Click" 
                        Background="#4CAF50" 
                        Foreground="White"/>
                <Button x:Name="CreateButton" 
                        Content="Create New" 
                        Click="CreateButton_Click" 
                        Background="#2196F3" 
                        Foreground="White"/>
                <Button x:Name="EditButton" 
                        Content="Edit" 
                        Click="EditButton_Click" 
                        Background="#FF9800" 
                        Foreground="White"/>
                <Button x:Name="DeleteButton" 
                        Content="Delete" 
                        Click="DeleteButton_Click" 
                        Background="#FF6B6B" 
                        Foreground="White"/>
            </StackPanel>

            <!-- Info Message -->
            <TextBlock x:Name="InfoTextBlock" 
                       Text="" 
                       Foreground="#666666" 
                       TextWrapping="Wrap" 
                       Margin="0,10,0,0" 
                       MinHeight="40"
                       FontSize="11"/>
        </StackPanel>
    </Grid>
</Window>
